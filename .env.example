# Site
NEXT_PUBLIC_SITE_URL=https://turtle-soup-rust.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=okto0914@gmail.com

# =========================
# Existing Database (Supabase)
# =========================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — cron / Threads token storage / puzzle insert (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# =========================
# Groq AI
# =========================
GROQ_API_KEY=
# This Groq org has openai/gpt-oss-20b (and qwen). llama-* is NOT available.
# Code never uses response_format json_* — it fails with json_validate_failed.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# Optional second Groq judge call (needs longer serverless timeout / Pro). Default off for Hobby.
# GROQ_JUDGE_ENABLED=true

# =========================
# Meta Threads API
# =========================
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://turtle-soup-rust.vercel.app/auth/threads/callback
# After OAuth you can paste long-lived token + user id here (or rely on DB threads_tokens)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# Random secrets — generate with: openssl rand -hex 32
THREADS_STATE_SECRET=
TOKEN_ENCRYPTION_KEY=

# =========================
# Scheduler / Admin
# =========================
CRON_SECRET=
ADMIN_SECRET=
# Optional: default batch size for admin generation API (1–15, default 8)
GENERATION_BATCH_SIZE=8

# =========================
# Google AdSense / Analytics (optional)
# =========================
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-4462339094246168
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_CLOSED=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
